{
  "name": "raincode-browser",
  "productName": "RainCode Browser",
  "version": "0.5.23",
  "description": "A private Chromium browser and calm developer workspace",
  "author": "Vilya",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "tor:prepare": "node scripts/prepare-tor.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts *.ts *.mjs",
    "format": "prettier --write src tests scripts *.json *.ts *.mjs *.md index.html",
    "format:check": "prettier --check src tests scripts *.json *.ts *.mjs *.md index.html",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "node scripts/build.mjs && electron-builder --dir",
    "dist": "node scripts/build.mjs && electron-builder",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "openpgp": "6.3.2",
    "prettier": "3.9.10",
    "tar": "7.5.22",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "dev.raincode.browser",
    "productName": "RainCode Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "LICENSES.md"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "vendor/tor/win32-x64",
        "to": "tor/win32-x64",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "build/raincode.ico",
        "to": "raincode.ico"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signExecutable": false,
      "icon": "build/raincode.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development;Network;WebBrowser"
    }
  }
}
